# Server-only secrets
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Generation cost controls. Runtime Cache provides soft, regional MVP limits;
# move counters to an atomic data store before treating them as billing controls.
GENERATION_BURST_LIMIT=3
GENERATION_DAILY_LIMIT=10
GENERATION_GLOBAL_DAILY_LIMIT=250
GENERATION_CACHE_TTL_SECONDS=21600
GENERATION_TIMEOUT_MS=20000
GENERATION_IP_HASH_SALT=

# Safe to expose to the browser. Do not put a Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Use a modern sb_secret_... key, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
