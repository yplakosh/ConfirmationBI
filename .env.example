# Server-only secrets
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Server-only emergency switches. Changes require a Vercel redeploy.
# Live OpenAI calls are opt-in and cost the project owner money.
GENERATION_PAID_ENABLED=false
PUBLISHING_ENABLED=true

# Atomic Postgres quotas: apply the quota migration BEFORE deploying.
# All results (including cached/demo) consume a report reservation.
GENERATION_BURST_LIMIT=6
REPORT_ANONYMOUS_DAILY_LIMIT=20
REPORT_AUTHENTICATED_DAILY_LIMIT=50
REPORT_GLOBAL_DAILY_LIMIT=500
# Additional limits for attempted paid calls, not dollar budgets.
GENERATION_ANONYMOUS_DAILY_LIMIT=5
GENERATION_AUTHENTICATED_DAILY_LIMIT=20
GENERATION_GLOBAL_DAILY_LIMIT=100
GENERATION_CACHE_TTL_SECONDS=21600
GENERATION_TIMEOUT_MS=20000
GENERATION_IP_HASH_SALT=

# Safe to expose to the browser. Do not put a Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Use a modern sb_secret_... key, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
